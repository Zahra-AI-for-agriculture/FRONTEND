# =============================================
# Angular / Node.js .gitignore
# =============================================

# --- Compiled output ---
dist/
tmp/
out-tsc/

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDEs & Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# --- Angular cache ---
.angular/

# --- System files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Environment files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Testing ---
coverage/
.nyc_output/

# --- Misc ---
*.log
*.tgz
.pnp.*
.yarn/install-state.gz
